#!/bin/sh
# Blocks a commit if gitleaks finds a likely secret in the staged changes.
# This is a fast local backstop only — the authoritative gate is the
# `gitleaks` step in the `security-scan` job of .github/workflows/ci.yml,
# which scans full git history on every push/PR. See docs/DEVELOPMENT.md
# ("Preventing committed secrets") for how to enable this hook.

GITLEAKS_BIN="$(command -v gitleaks 2>/dev/null)"
if [ -z "$GITLEAKS_BIN" ] && [ -x "$(go env GOPATH 2>/dev/null)/bin/gitleaks" ]; then
    # `go install` puts binaries in $(go env GOPATH)/bin, which many shells
    # (and non-interactive git hook environments) never add to PATH.
    GITLEAKS_BIN="$(go env GOPATH)/bin/gitleaks"
fi

if [ -z "$GITLEAKS_BIN" ]; then
    echo "pre-commit: gitleaks not found, skipping local secret scan" >&2
    echo "  (CI will still catch this on push) install with:" >&2
    echo "  go install github.com/zricethezav/gitleaks/v8@v8.28.0" >&2
    exit 0
fi

"$GITLEAKS_BIN" protect --staged --redact --no-banner
